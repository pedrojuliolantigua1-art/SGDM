@{
    ViewData["Title"] = "Sistema de Gestión de Citas Médicas";
}

<div class="text-center">
    <h1 class="display-4">Sistema de Gestión de Citas Médicas</h1>
    <p class="lead">Sistema profesional para la gestión de citas médicas con control de capacidad en tiempo real.</p>
</div>

<div class="row mt-5">
    <div class="col-md-6 mb-4">
        <a asp-controller="Doctors" asp-action="Index" class="text-decoration-none">
            <div class="card h-100 shadow-sm border-0 transition-shadow">
                <div class="card-body text-center p-5">
                    <i class="bi bi-person-badge display-1 text-primary mb-3"></i>
                    <h3 class="card-title">Gestión de Doctores</h3>
                    <p class="card-text text-muted">
                        Registrar doctores, configurar horarios y definir capacidad diaria por bloque horario.
                    </p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-6 mb-4">
        <a asp-controller="Appointments" asp-action="Index" class="text-decoration-none">
            <div class="card h-100 shadow-sm border-0 transition-shadow">
                <div class="card-body text-center p-5">
                    <i class="bi bi-calendar-check display-1 text-success mb-3"></i>
                    <h3 class="card-title">Agendar Citas</h3>
                    <p class="card-text text-muted">
                        Agendar nuevas citas con validación de capacidad en tiempo real y gestión del día.
                    </p>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row mt-3">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h4 class="card-title mb-4">Características del Sistema</h4>
                <div class="row">
                    <div class="col-md-6">
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                <strong>Control de Capacidad:</strong> Configuración de límites máximos de citas por día y bloque horario
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                <strong>Validación en Tiempo Real:</strong> Bloqueo automático al alcanzar la capacidad máxima
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                <strong>Bloqueo Manual:</strong> Capacidad de bloquear/desbloquear días específicos
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                <strong>Concurrencia Segura:</strong> Transacciones ACID con Entity Framework Core
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                <strong>Configuración Masiva:</strong> Configurar capacidad para rangos de fechas completas
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                <strong>Interfaz Intuitiva:</strong> Diseño responsive y fácil de usar
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
