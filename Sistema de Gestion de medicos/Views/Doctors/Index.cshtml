@model IEnumerable<Sistema_de_Gestion_de_medicos.Models.Entities.Doctor>

@{
    ViewData["Title"] = "Gestión de Doctores";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-badge"></i> Gestión de Doctores</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Doctor
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-x display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">No hay doctores registrados</h5>
                    <p class="text-muted">Haga clic en "Nuevo Doctor" para comenzar.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Especialidad</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doctor in Model)
                            {
                                <tr class="@(!doctor.IsActive ? "table-secondary" : "")">
                                    <td>
                                        <strong>@doctor.FullName</strong>
                                    </td>
                                    <td>@doctor.Specialty</td>
                                    <td>@doctor.Email</td>
                                    <td>@doctor.Phone</td>
                                    <td>
                                        @if (doctor.IsActive)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="Edit" asp-route-id="@doctor.Id"
                                               class="btn btn-sm btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Schedule" asp-route-id="@doctor.Id"
                                               class="btn btn-sm btn-outline-info" title="Horarios">
                                                <i class="bi bi-calendar3"></i>
                                            </a>
                                            <a asp-action="Capacity" asp-route-id="@doctor.Id"
                                               class="btn btn-sm btn-outline-warning" title="Capacidad">
                                                <i class="bi bi-speedometer2"></i>
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@doctor.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-@(doctor.IsActive ? "danger" : "success")"
                                                        title="@(doctor.IsActive ? "Desactivar" : "Activar")">
                                                    <i class="bi bi-@(doctor.IsActive ? "pause-circle" : "play-circle")"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
